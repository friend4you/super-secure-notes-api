DATABASE_URL=postgresql+asyncpg://ssn:ssn@localhost:5432/supersecurenotes
JWT_SECRET=dev-secret-change-in-production

# Render: paste the dashboard DATABASE_URL as-is (postgres:// or postgresql://).
# The app rewrites it to postgresql+asyncpg:// and enables TLS. Set JWT_SECRET
# to a long random value — the default is rejected on Render.
